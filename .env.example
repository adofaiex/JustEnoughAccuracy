# Copy this file to .env and set your game path(s).
# .env is git-ignored, so your local game installs never get committed.
#
# ADOFAI_GAME_PATH is the default used by every loader (and the core project).
# Each loader can use its own key to target a different game install:
#
#   ADOFAI_GAME_PATH=...            default (all loaders, required for building)
#   ADOFAI_GAME_PATH_UMM=...        UMM loader
#   ADOFAI_GAME_PATH_ML=...         MelonLoader
#   ADOFAI_GAME_PATH_BEPINEX=...    BepInEx
#   ADOFAI_GAME_PATH_DOORSTOP=...   Doorstop
#
# A loader falls back to ADOFAI_GAME_PATH when its own key is empty.
#
# Windows example:
#   ADOFAI_GAME_PATH=C:\Games\ADOFAI\ADanceOfFireAndIce.exe
# Linux/macOS example:
#   ADOFAI_GAME_PATH=/path/to/A Dance of Fire and Ice/ADanceOfFireAndIce

ADOFAI_GAME_PATH=
